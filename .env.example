# =============================================================================
# Auto Spare Parts ERP - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# This file contains placeholders only. Never commit a populated .env file.
# Production credentials must be injected by a secret manager or encrypted
# deployment variables. See OPERATIONS_RUNBOOK.md before deploying.

# -----------------------------------------------------------------------------
# PostgreSQL Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=autostockmanager
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_PORT=6379
# Required by docker-compose.production.yml: Redis starts with --requirepass and
# the API/worker REDIS_URL is built as redis://:${REDIS_PASSWORD}@redis:6379/0.
# Leave unset for the development stack, which runs Redis without a password.
# REDIS_PASSWORD=replace-with-secret-manager-value

# -----------------------------------------------------------------------------
# Backend (FastAPI) Configuration
# -----------------------------------------------------------------------------
BACKEND_PORT=8000
SECRET_KEY=your-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
# Log verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL. Leave unset to
# follow the environment (DEBUG in development, INFO in staging/production).
# Logs are JSON outside development and redact secrets before emission.
# LOG_LEVEL=INFO
# Apply migrations before the application accepts traffic. The Docker image
# already runs this command before Uvicorn; set this to true only when using
# controlled application-startup migrations instead.
RUN_MIGRATIONS_ON_STARTUP=false

# Generate a production JWT secret with at least 32 random bytes, then store
# it in the secret manager (do not commit the generated value):
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# openssl rand -base64 32
RATE_LIMIT_UNAUTHENTICATED=20
RATE_LIMIT_AUTHENTICATED=100
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REFRESH=10
RATE_LIMIT_PASSWORD_RESET=5
RATE_LIMIT_PASSWORD_RESET_CONFIRM=5
# Maximum request body size in bytes (default: 5 MiB)
MAX_REQUEST_BODY_BYTES=5242880

# Error tracking (disabled by default; enable only with a DSN in staging/production)
ERROR_TRACKER_ENABLED=false
# ERROR_TRACKER_DSN=https://<public-key>@sentry.example.invalid/<project-id>
ERROR_TRACKER_ENVIRONMENT=development
ERROR_TRACKER_SAMPLE_RATE=1.0
# ERROR_TRACKER_RELEASE=commit-or-build-version

# CORS origins (comma-separated for multiple origins; production must use only
# trusted frontend origins and must not use '*')
CORS_ORIGINS=http://localhost:3000

# Refresh token cookie. The refresh credential is HTTP-only, so browsers never
# expose it to JavaScript. Keep the path narrow so it is only sent to the auth
# endpoints. SameSite=strict works when the UI and API share a site (for example
# app.example.com calling api.example.com). If the UI and API are on different
# sites, neither strict nor lax is sent on the cross-site refresh request, so
# that hosting model requires REFRESH_COOKIE_SAMESITE=none plus a Secure cookie
# and trusted CORS_ORIGINS. REFRESH_COOKIE_SECURE is left
# unset to derive from ENVIRONMENT (Secure everywhere except development) and
# must never be false in production.
REFRESH_COOKIE_NAME=asm_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SAMESITE=strict
# REFRESH_COOKIE_SECURE=true

# Password reset links and SMTP delivery. SMTP is required outside development.
FRONTEND_BASE_URL=http://localhost:3000
PASSWORD_RESET_PATH=/reset-password
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USERNAME=mailer@example.com
# SMTP_PASSWORD=replace-with-secret-manager-value
# SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true

# Database URL (constructed from PostgreSQL vars in docker-compose, override for local dev)
# DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/autostockmanager

# Separate migration identity for least-privilege enforcement (production).
# The application DATABASE_URL should use a DML-only role; this URL uses a
# DDL-capable role for Alembic migrations only. Falls back to DATABASE_URL
# when not set (acceptable for development).
# MIGRATION_DATABASE_URL=postgresql+asyncpg://autostockmanager_migrate_user:secret@localhost:5432/autostockmanager

# Redis URL (constructed in docker-compose, override for local dev)
# REDIS_URL=redis://localhost:6379/0
# ARQ queue and worker controls
JOB_QUEUE_NAME=arq:queue
JOB_MAX_TRIES=5
JOB_BASE_BACKOFF_SECONDS=1
JOB_MAX_BACKOFF_SECONDS=300
JOB_TIMEOUT_SECONDS=300
JOB_MAX_CONCURRENCY=10

# Frontend (Next.js) Configuration
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Production note: use ENVIRONMENT=production, a non-placeholder SECRET_KEY,
# non-placeholder POSTGRES_PASSWORD, trusted CORS_ORIGINS, and secret-manager
# supplied SMTP credentials. Do not expose database or Redis ports publicly.
